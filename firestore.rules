rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Players are signed in anonymously by the page (no login screen).
    // Moderators sign in with Google and must be listed in /admins.
    function signedIn() { return request.auth != null; }
    function hasEmail() {
      return request.auth != null
          && request.auth.token.get('email_verified', false) == true
          && request.auth.token.get('email', '') != '';
    }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminDoc() { return /databases/$(database)/documents/admins/$(myEmail()); }
    function isAdmin() { return hasEmail() && exists(adminDoc()); }
    function isOwner() { return isAdmin() && get(adminDoc()).data.role == 'owner'; }

    // Who may use the moderator tools. Only owners change this list.
    match /admins/{email} {
      allow get: if hasEmail() && email == myEmail();
      allow list: if isAdmin();
      allow write: if isOwner();
    }

    // Ladder order, round settings, pairings, results and the chosen sheet.
    // Everyone can read; only moderators can change.
    match /ladder/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /pairings/{id}  { allow read: if true; allow write: if isAdmin(); }
    // Inactivity strikes and removals, written when an moderator starts the next round.
    match /inactivity/{id} { allow read: if true; allow write: if isAdmin(); }
    // Yellow and red cards, entered by hand by moderators.
    match /cards/{id} { allow read, write: if isAdmin(); }

    // Player entries. Any visitor can add, change and remove them, with no login.
    // The page names each entry's author by player, so this is trust-based: the rules
    // only check the shape of the data, and moderators can clear everything.
    match /challenges/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['challengerId', 'challengerName', 'challengerRank',
                         'targetId', 'targetName', 'targetRank', 'round', 'status', 'pref', 'at', 'uid']);
      allow update: if signedIn()
                    && request.resource.data.keys().hasOnly(['challengerId', 'challengerName', 'challengerRank',
                         'targetId', 'targetName', 'targetRank', 'round', 'status', 'pref', 'at', 'uid']);
      allow delete: if signedIn();
    }
    match /moves/{id} {
      allow read: if true;
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.type in ['bye', 'revoke']
                    && request.resource.data.keys().hasOnly(['type', 'playerId', 'round', 'at', 'uid']);
      allow update: if isAdmin();
      allow delete: if signedIn();
    }
  }
}
